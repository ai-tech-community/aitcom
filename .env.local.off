# Host (native `pnpm dev`) → Dockerised Postgres + wsproxy.
# Next.js loads .env.local with higher priority than .env, so this overrides
# ONLY the database keys; your real auth secrets still come from .env.
# Gitignored. Start the DB tier first:  docker compose up -d postgres wsproxy
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aitcom
NEON_LOCAL_PROXY=localhost:5433
