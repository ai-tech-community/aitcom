{
  "name": "aitcom",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "benchmark:seed": "pnpm dlx tsx --env-file=.env src/scripts/seed-benchmark.ts",
    "datacenters:seed": "pnpm dlx tsx --env-file=.env src/scripts/seed-datacenters.ts",
    "suppliers:seed": "pnpm dlx tsx --env-file=.env src/scripts/seed-suppliers.ts",
    "commitments:seed": "pnpm dlx tsx --env-file=.env src/scripts/seed-commitments.ts",
    "investigations:seed": "pnpm dlx tsx --env-file=.env src/scripts/seed-investigations.ts",
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
