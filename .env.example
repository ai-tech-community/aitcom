# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth (min 32 chars, generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Better Auth GitHub OAuth
# Create a GitHub OAuth app at https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth LinkedIn OAuth (optional — verified LinkedIn on member profiles)
# Create an app at https://www.linkedin.com/developers/apps
# Product: "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: {BETTER_AUTH_URL}/api/auth/callback/linkedin
# Leave unset to hide LinkedIn connect in settings. A pasted URL is not verified.
BETTER_AUTH_LINKEDIN_CLIENT_ID=""
BETTER_AUTH_LINKEDIN_CLIENT_SECRET=""

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payload CMS (min 32 chars, generate with: openssl rand -base64 32)
PAYLOAD_SECRET=""

# Local-only: set to "true" to build the Payload schema from config via push
# (there is no base-table migration). Keep unset in production. See ADR-0020.
# PAYLOAD_PUSH="true"

# Database (PostgreSQL connection string)
# For Neon: https://neon.tech/ — or use any PostgreSQL instance
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Local-only: set to the host:port of a Neon wsproxy to run the serverless
# driver against a local Postgres (the Docker stack sets this automatically).
# Leave unset when pointing DATABASE_URL at Neon's cloud. See ADR-0020.
# NEON_LOCAL_PROXY="localhost:5433"

# Email (Resend — https://resend.com/)
# Required to send signup verification, password reset, and welcome mail.
# When set, email/password sign-in requires a verified address.
RESEND_API_KEY=""

# Cron job authorization (generate with: openssl rand -base64 32)
CRON_SECRET=""

# AWS S3 Storage (for file uploads)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="eu-central-1"
