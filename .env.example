# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth (min 32 chars, generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Production (VERCEL_ENV=production) pins auth to https://www.aitcommunity.org
# or an explicit https://aitcommunity.org URL — never a *.vercel.app preview.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_BASE_URL="http://localhost:3000"

# Better Auth GitHub OAuth
# Create a GitHub OAuth app at https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth LinkedIn OAuth (optional — verified LinkedIn on member profiles)
# Create an app at https://www.linkedin.com/developers/apps
# Product: "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: {BETTER_AUTH_URL}/api/auth/callback/linkedin
# Leave unset to hide LinkedIn connect in settings. A pasted URL is not verified.
BETTER_AUTH_LINKEDIN_CLIENT_ID=""
BETTER_AUTH_LINKEDIN_CLIENT_SECRET=""

# Better Auth Google OAuth (optional — sign-in only, not a verified identity)
# Google Cloud Console → Google Auth Platform → Clients → Web application
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Leave unset to hide the Google button. Does not work on *.vercel.app previews.
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional extra Better Auth origins (comma or space separated).
# Vercel preview hosts are trusted automatically via VERCEL_URL.
# BETTER_AUTH_TRUSTED_ORIGINS="https://staging.aitcommunity.org"

# Payload CMS (min 32 chars, generate with: openssl rand -base64 32)
PAYLOAD_SECRET=""

# Local-only: set to "true" to build the Payload schema from config via push
# (there is no base-table migration). Keep unset in production. See ADR-0020.
# PAYLOAD_PUSH="true"

# Database (PostgreSQL connection string)
# For Neon: https://neon.tech/ — or use any PostgreSQL instance
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Local-only: set to the host:port of a Neon wsproxy to run the serverless
# driver against a local Postgres (the Docker stack sets this automatically).
# Leave unset when pointing DATABASE_URL at Neon's cloud. See ADR-0020.
# NEON_LOCAL_PROXY="localhost:5433"

# Email (Resend — https://resend.com/)
# Required to send signup verification, password reset, and welcome mail.
# When set, email/password sign-in requires a verified address.
RESEND_API_KEY=""

# Friend invitations: keep OFF until Greg approves launch. Production only.
# Generate a dedicated stable secret; do not reuse or rotate the auth secret.
# Configure /api/referral-invites/webhook in Resend before enabling sends.
REFERRAL_INVITES_ENABLED="false"
REFERRAL_INVITE_REMINDERS_ENABLED="false"
REFERRAL_INVITE_SECRET=""
REFERRAL_RESEND_WEBHOOK_SECRET=""

# Cron job authorization (generate with: openssl rand -base64 32)
CRON_SECRET=""

# AWS S3 Storage (for file uploads)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="eu-central-1"

# Classroom lesson file uploads: "on" lets course authors upload files into
# lessons. Leave empty (off) until the app's AWS user may read, write, delete
# and list under private/classroom/* in S3_BUCKET. Existing files still work
# while it is off.
CLASSROOM_FILE_UPLOADS=
# Collector ids to switch off, comma-separated (e.g. "feed-items").
COLLECTORS_DISABLED=

# AIT-owned inference. Optional. Read directly from process.env (not src/env.js)
# so a missing key does not fail the build. News summaries stay empty until
# OPENROUTER_API_KEY is set. Benchmark extraction, prompt suggestions, and
# strategy fail closed until it is set. Default model is Qwen3-8B
# (qwen/qwen3-8b, 8.2B dense, Apache-2.0) on OpenRouter's OpenAI-compatible
# chat completions API. ANTHROPIC_API_KEY is not used.
# OPENROUTER_API_KEY=""
# EXTRACTOR_MODEL="qwen/qwen3-8b"
# NEWS_SUMMARY_MODEL="qwen/qwen3-8b"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Community-owned payments. Apply the additive migration before enabling.
# Keep the rollout flag enabled once paid offers exist. Pause sales in owner settings.
COMMUNITY_PAYMENTS_ENABLED=false
# Community gallery. Apply the 20261113a migration and grant the app's S3 user
# the media/gallery/* and private/gallery/* prefixes before enabling.
COMMUNITY_GALLERY_ENABLED=false
# Stripe Connect OAuth is used so owners can connect existing independent accounts.
# Register redirect: /api/payments/stripe/connect
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
# Adyen for Platforms; checkout and platform credentials are separate.
ADYEN_ENVIRONMENT=test
# Merchant capture setting must be Manual; pay links also force manual capture.
ADYEN_CAPTURE_MODE=manual
ADYEN_API_KEY=
ADYEN_PLATFORM_API_KEY=
ADYEN_MANAGEMENT_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_BALANCE_PLATFORM=
ADYEN_LIVE_PREFIX=
# Approved community seller industry classification, agreed with Adyen.
ADYEN_INDUSTRY_CODE=
ADYEN_HMAC_KEY=
# Raw-body HMAC key for recurring.token.created lifecycle webhooks.
ADYEN_TOKEN_HMAC_KEY=
