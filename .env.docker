# Safe, non-secret defaults for the local Docker stack (docker-compose.yml).
# Committed on purpose so `docker compose up` works with zero configuration.
# DO NOT put real secrets here — override locally or use a real .env instead.

NODE_ENV=development

# DATABASE_URL and NEON_LOCAL_PROXY are set in docker-compose.yml (service names).
# No sslmode: Payload rewrites require/prefer -> verify-full, which a non-TLS
# local Postgres rejects. See ADR-0020.

# Auth — dummy values so the app boots; email/password works via the seeded dev
# user. GitHub OAuth is non-functional with these placeholders (that's fine).
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0000000000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_GITHUB_CLIENT_ID=dev-unused
BETTER_AUTH_GITHUB_CLIENT_SECRET=dev-unused

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS
PAYLOAD_SECRET=dev-payload-secret-change-me-00000000000000
# Build the Payload schema from config via push (no base-table migration exists).
# Keep this OFF in production, which uses migrations. See ADR-0020.
PAYLOAD_PUSH=true

# Cron endpoint authorization (local only)
CRON_SECRET=dev-cron-secret

# Seed the database on first boot. Set to false for an empty DB.
SEED_ON_START=true

# Local dev login created by scripts/seed-dev-user.ts
DEV_USER_EMAIL=dev@aitcommunity.local
DEV_USER_PASSWORD=devpassword123
DEV_USER_NAME=Dev User
